{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

http://:80 {
	log {
		level DEBUG
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}
	bind 0.0.0.0
	root /app/public
	encode zstd gzip

	# vulcain Enbale when hypermedia (JSON-LD, HAL) is needed.

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	handle /.well-known/mercure* {
		mercure {
			# Mercure in FrankenPHP >= 1.13 rejects publisher_jwt/subscriber_jwt outside
			# compatibility mode. Modern mode (issuer blocks + "iss" claim in every token)
			# is pending: docs/fase3-mail-telegram.md §4.
			protocol_version_compatibility 8
			anonymous
			publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY:!ChangeThisSecret!} HS256
			# Without it no subscriber can be authorized for private updates.
			# Same key on purpose: MercureBundle signs both token kinds with MERCURE_JWT_SECRET.
			subscriber_jwt {$MERCURE_PUBLISHER_JWT_KEY:!ChangeThisSecret!} HS256
		}
	}

	@phpRoute {
		not path /.well-known/mercure*
		not file {path}
	}
	rewrite @phpRoute index.php

	php_server {
		file_server off # We serve static files in the frontend.
	}
}
