meta {
  name: Update Me (self)
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/api/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Mi Nombre Actualizado"
  }
}

docs {
  Cambiar solo `name` no pide nada más. Para cambiar `email` o `password` hay
  que mandar también `currentPassword` (la contraseña actual); sin ella, o si
  es incorrecta, responde 403. Ejemplo:
  
  { "password": "nuevaClave", "currentPassword": "claveActual" }
}
