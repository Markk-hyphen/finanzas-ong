# Symfony
APP_SECRET=supah_hacker_random_string_123
SERVER_NAME=0.0.0.0:80
HTTP_PORT=80

# NO agregar acá una variable con la versión de PHP. La versión la fija el tag exacto
# de la imagen base en backend/Dockerfile (FROM ... AS frankenphp_upstream), que es la
# ÚNICA fuente de verdad: nada en el runtime la lee de una env var. Hubo un
# `PHP_VERSION=8.3.13` acá que no consumía nadie y quedó 23 patches atrás; el riesgo no
# era el valor viejo sino que se lee como la versión del proyecto, así que al parchear un
# CVE se bumpea ESTO, se ve el número correcto y se cree que el fix se aplicó.

# Database — SOLO para infra compartida (override).
# Standalone: NO tocar esto; DATABASE_URL vive en .env (junto a POSTGRES_*).
# Infra compartida (prod): descomentar y apuntar al Postgres compartido (host
# `postgres`), con el usuario/base que provisiona infra — NO 'app'/'database'.
# Esta línea, al cargarse después de .env, PISA el DATABASE_URL standalone.
#DATABASE_URL=postgresql://ong_user:PROVISIONED_PASS@postgres:5432/ong_db?serverVersion=15&charset=utf8

# Caddy
CADDY_GLOBAL_OPTIONS=#
CADDY_EXTRA_CONFIG=#
CADDY_SERVER_LOG_OPTIONS=#
CADDY_SERVER_EXTRA_DIRECTIVES=#
# Replaced dynamically in docker-entrypoint

# JWT
JWT_PASSPHRASE=appClicGo35801822

# RabbitMQ — credentials must match RABBITMQ_DEFAULT_USER/PASS in docker-compose.yml
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_DSN=amqp://app:app@rabbitmq:5672/%2f

# Mercure — same secret used by Caddyfile (MERCURE_PUBLISHER_JWT_KEY) and MercureBundle (MERCURE_JWT_SECRET)
MERCURE_PUBLISHER_JWT_KEY=36b6c43013b9e9829daeddf83a8b7030cf133784ea391a2c0e455dd7bc78ea39
MERCURE_JWT_SECRET=36b6c43013b9e9829daeddf83a8b7030cf133784ea391a2c0e455dd7bc78ea39
MERCURE_URL=http://localhost/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure